# AutoCut API Configuration
# 请填入你的实际 API keys

# LLM (Large Language Model) Configuration - 阿里云通义千问
LLM_API_KEY=sk-38491e04ccc243078aff689ef54b2a0a
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ASR (Automatic Speech Recognition) Configuration - 阿里云语音识别
ASR_API_KEY=sk-38491e04ccc243078aff689ef54b2a0a
ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/audio/transcriptions

# ASR Advanced Configuration
# 默认语音识别后端: aliyun_paraformer_v2, aliyun_paraformer, whisper_local, mock
# 提示：先试试 whisper_local，无需API Key，首次运行会自动下载模型
ASR_DEFAULT_BACKEND=whisper_local

# Whisper Local Model Configuration (可选)
# 模型大小: tiny, base, small, medium, large
# tiny (39MB) - 最快但准确率稍低
# base (74MB) - 平衡速度和准确率 (推荐)
# small (244MB) - 更好的准确率
# medium (769MB) - 高准确率
# large (1550MB) - 最高准确率
WHISPER_MODEL_SIZE=medium
# 设备: cpu, cuda (如果有NVIDIA GPU)
WHISPER_DEVICE=cuda

# ASR Timeout and Retry Configuration
# API调用超时时间（秒）
ASR_TIMEOUT=120
# 最大重试次数
ASR_MAX_RETRIES=3

# VLM (Vision Language Model) Configuration - 阿里云视觉理解
VLM_API_KEY=sk-38491e04ccc243078aff689ef54b2a0a
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
